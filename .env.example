# Canonical site URL used for metadata, canonical tags, sitemap and robots.txt.
# On Vercel, set this to your production domain, e.g. https://techpulse.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Newsletter delivery (Buttondown). Leave empty to keep the form in its disabled
# demo state, or set it to the username from your Buttondown dashboard
# (https://buttondown.com/<username>) to start accepting real subscriptions.
NEXT_PUBLIC_BUTTONDOWN_USERNAME=
